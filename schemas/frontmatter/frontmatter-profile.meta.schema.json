{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datadoghq.com/ai-shared-lib-public/schemas/frontmatter/frontmatter-profile.meta.schema.json",
  "title": "Frontmatter validation profile — meta-schema",
  "description": "Meta-schema for the frontmatter validation profile family. A conforming document is EITHER a core-profile (mechanisms, e.g. frontmatter-core.schema.json) OR an extension-pack (concrete vocab, e.g. frontmatter-psa-apm.pack.json), discriminated by `kind`. Validate each profile/pack file against this meta-schema to prove structural well-formedness (the M2.P1.T1 acceptance: 'schema loads + validates against its own meta-schema'). JSON Schema 2020-12; validate with any 2020-12 validator, e.g. `python -m jsonschema -i <file> frontmatter-profile.meta.schema.json`.",
  "type": "object",
  "required": ["kind", "profile", "version", "description"],
  "properties": {
    "kind": { "type": "string", "enum": ["core-profile", "extension-pack"] },
    "profile": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[a-z0-9-]+@[0-9]+$" },
    "description": { "type": "string", "minLength": 1 }
  },
  "oneOf": [
    { "$ref": "#/$defs/coreProfile" },
    { "$ref": "#/$defs/extensionPack" }
  ],
  "$defs": {
    "coreProfile": {
      "type": "object",
      "required": ["kind", "cardinality_types", "authorship", "mechanisms", "violation_cascade", "codes"],
      "properties": {
        "kind": { "const": "core-profile" },
        "cardinality_types": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["min", "meaning", "codes"],
            "properties": {
              "min": { "type": "integer", "minimum": 0 },
              "max": { "type": ["integer", "null"] },
              "meaning": { "type": "string" },
              "codes": { "type": "object" },
              "source": { "type": "string" }
            }
          }
        },
        "authorship": {
          "type": "object",
          "required": ["values"],
          "properties": {
            "values": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        },
        "mechanisms": {
          "type": "object",
          "required": ["required_fields", "description_caps", "namespaces", "report", "file_class", "exempt"],
          "additionalProperties": {
            "type": "object",
            "required": ["meaning"],
            "properties": {
              "meaning": { "type": "string" },
              "code": { "type": "string" },
              "codes": { "type": "object" },
              "source": { "type": "string" }
            }
          }
        },
        "violation_cascade": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["step"],
            "properties": {
              "step": { "type": "string" },
              "iterate": { "type": "string" },
              "action": { "type": "string" },
              "guard": { "type": "string" },
              "emit": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["when", "code", "field", "message"],
                  "properties": {
                    "when": { "type": "string" },
                    "code": { "type": "string" },
                    "field": { "type": "string" },
                    "message": { "type": "string" }
                  }
                }
              },
              "source": { "type": "string" }
            }
          }
        },
        "codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["code", "meaning"],
            "properties": {
              "code": { "type": "string" },
              "meaning": { "type": "string" },
              "source": { "type": "string" }
            }
          }
        }
      }
    },
    "extensionPack": {
      "type": "object",
      "required": ["kind", "extends", "required_fields", "description_caps", "file_class", "namespaces", "report", "exempt"],
      "properties": {
        "kind": { "const": "extension-pack" },
        "extends": { "type": "string", "pattern": "^[a-z0-9-]+@[0-9]+$" },
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["field", "authorship"],
            "properties": {
              "field": { "type": "string" },
              "authorship": { "type": "string", "enum": ["machine_derivable", "human_authored"] },
              "source": { "type": "string" }
            }
          }
        },
        "description_caps": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "source": { "type": "string" }
          },
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "file_class": {
          "type": "object",
          "required": ["default", "rules"],
          "properties": {
            "default": { "type": "string" },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["class", "match"],
                "properties": {
                  "class": { "type": "string" },
                  "match": {
                    "type": "object",
                    "required": ["glob"],
                    "properties": { "glob": { "type": "string" } }
                  },
                  "source": { "type": "string" }
                }
              }
            },
            "note": { "type": "string" }
          }
        },
        "namespaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "cardinality"],
            "properties": {
              "name": { "type": "string" },
              "cardinality": { "type": "string", "enum": ["singleton", "at_least_one", "optional"] },
              "parents": { "type": "array", "items": { "type": "string" } },
              "report_only": { "type": "boolean" },
              "source": { "type": "string" }
            }
          }
        },
        "report": {
          "type": "object",
          "required": ["trigger", "required_namespaces", "period"],
          "properties": {
            "trigger": {
              "type": "object",
              "required": ["namespace", "value"],
              "properties": {
                "namespace": { "type": "string" },
                "value": { "type": "string" }
              }
            },
            "required_namespaces": {
              "type": "array",
              "items": { "type": "string" }
            },
            "period": {
              "type": "object",
              "required": ["namespace", "regex"],
              "properties": {
                "namespace": { "type": "string" },
                "regex": { "type": "string" }
              }
            },
            "notes": { "type": "string" },
            "source": { "type": "string" }
          }
        },
        "exempt": {
          "type": "object",
          "required": ["filenames", "dir_components", "path_globs"],
          "properties": {
            "filenames": { "type": "array", "items": { "type": "string" } },
            "dir_components": { "type": "array", "items": { "type": "string" } },
            "path_globs": { "type": "array", "items": { "type": "string" } },
            "source": { "type": "string" }
          }
        }
      }
    }
  }
}
