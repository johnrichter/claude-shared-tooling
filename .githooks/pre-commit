#!/usr/bin/env bash
# Local privacy guardrail (Layer 1 — convenience, bypassable with --no-verify).
# Enable once per clone:  git config core.hooksPath .githooks
# The authority is the CI required check (.github/workflows/ci.yml).
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
python3 "$ROOT/scripts/check_privacy.py" --root "$ROOT"
python3 "$ROOT/scripts/check_no_raw_binary.py" --staged --root "$ROOT"
