#!/bin/sh
# jr-readme-manifest — platform selector.
#
# Consumers exec this script; it never builds anything (no Go toolchain
# reliance) — it just picks and execs the pre-built binary for the current
# darwin/linux x arm64/amd64 platform. Add a new platform by dropping a
# jr-readme-manifest-<os>-<arch> binary alongside this script and extending
# the case statements below.
set -eu

script_dir=$(cd "$(dirname "$0")" && pwd)

os=$(uname -s)
case "$os" in
	Darwin) os_tag=darwin ;;
	Linux) os_tag=linux ;;
	*)
		echo "jr-readme-manifest: unsupported OS '$os' (supported: Darwin, Linux)" >&2
		exit 1
		;;
esac

arch=$(uname -m)
case "$arch" in
	arm64|aarch64) arch_tag=arm64 ;;
	x86_64|amd64) arch_tag=amd64 ;;
	*)
		echo "jr-readme-manifest: unsupported architecture '$arch' (supported: arm64, amd64)" >&2
		exit 1
		;;
esac

bin="$script_dir/jr-readme-manifest-$os_tag-$arch_tag"
if [ ! -x "$bin" ]; then
	echo "jr-readme-manifest: no pre-built binary for $os_tag/$arch_tag at $bin" >&2
	exit 1
fi

exec "$bin" "$@"
