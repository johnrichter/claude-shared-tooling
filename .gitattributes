#
# Self-contained git attributes for this repo — mirrors the machine-global set
# so nothing here depends on any given machine's global gitattributes. Text is
# normalized to LF; every binary class routes through Git LFS (never a raw blob),
# and scripts/check_no_raw_binary.py is the content-based backstop for binaries
# an extension glob misses (extensionless or unlisted).
#
# NOTE: git does NOT support inline/trailing comments in .gitattributes — a `#`
# mid-line corrupts the rule. Every comment is on its own line, above its rule.
#

#
# Repo-local — extensionless prebuilt binaries under .bin/, matched by name
# glob since they carry no extension for the class rules below to catch.
#
# Knowledge-agent `ka` binaries (one per OS/arch)
.bin/ka-* filter=lfs diff=lfs merge=lfs -text
# README-manifest CLI binaries (one per OS/arch)
.bin/jr-readme-manifest-* filter=lfs diff=lfs merge=lfs -text

#
# Line endings — auto-detect text vs binary, normalize text to LF; a few
# Windows script types are pinned to CRLF, and patch/diff bytes are preserved.
#
# Default: content-detect text, store + check out text as LF
* text=auto eol=lf
# Windows batch script — must stay CRLF
*.bat text eol=crlf
# Windows command script — must stay CRLF
*.cmd text eol=crlf
# PowerShell script — must stay CRLF
*.ps1 text eol=crlf
# Patch file — keep exact bytes; never eol-normalize (would corrupt the patch)
*.patch -text
# Diff file — keep exact bytes; never eol-normalize
*.diff -text

#
# Images — raster photos/graphics, plus vector and editor project files.
#
# Portable Network Graphics
*.png filter=lfs diff=lfs merge=lfs -text
# JPEG image
*.jpg filter=lfs diff=lfs merge=lfs -text
# JPEG image
*.jpeg filter=lfs diff=lfs merge=lfs -text
# Graphics Interchange Format image
*.gif filter=lfs diff=lfs merge=lfs -text
# Windows bitmap image
*.bmp filter=lfs diff=lfs merge=lfs -text
# Tagged Image File Format image
*.tiff filter=lfs diff=lfs merge=lfs -text
# Icon image
*.ico filter=lfs diff=lfs merge=lfs -text
# WebP image
*.webp filter=lfs diff=lfs merge=lfs -text
# AV1 Image File Format
*.avif filter=lfs diff=lfs merge=lfs -text
# High Efficiency Image Container (Apple)
*.heic filter=lfs diff=lfs merge=lfs -text
# Adobe Photoshop document
*.psd filter=lfs diff=lfs merge=lfs -text
# Adobe Illustrator document
*.ai filter=lfs diff=lfs merge=lfs -text
# Encapsulated PostScript vector image
*.eps filter=lfs diff=lfs merge=lfs -text

